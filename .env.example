# ==============================================================================
# HACKSPRINT 3.0 — PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION (RENDER / PROD)
# ==============================================================================

# 1. Port Configuration (Render injects PORT automatically, defaults to 3000 locally)
PORT=3000

# 2. Database Connection (Required)
# IMPORTANT: In MongoDB Atlas -> Network Access -> Add 0.0.0.0/0 (Render IPs are dynamic)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hacksprint3?retryWrites=true&w=majority

# 3. Admin Console Credentials (Required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HackSprint3@

# 4. Security & Cryptographic Tokens (Required)
# Used to sign HMAC authentication tokens for the Team Portal and Gate Passes
TEAM_SECRET=HackSprint3_Secure_Token_HMAC_Secret_Change_Me_In_Production_2026
SESSION_SECRET=HackSprint3_Session_Key_Change_Me_In_Production_2026

# 5. WhatsApp Onboarding Community Links (Optional - defaults embedded in server.js)
WHATSAPP_CONFIRMED_URL=https://chat.whatsapp.com/HJXSxdQWU7i6bLoza40MJQ?s=cl&p=a&mlu=4&ilr=4&iam=2
WHATSAPP_WAITLIST_URL=https://chat.whatsapp.com/HD6uTGs1YYGHRaKbnUGbeN?s=sh&p=a&mlu=4&ilr=4&iam=2
