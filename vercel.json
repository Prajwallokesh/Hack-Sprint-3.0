{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://hack-sprint-3-0.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://hack-sprint-3-0.onrender.com/uploads/:path*"
    }
  ]
}
